<Window x:Class="Fufuu.Wpf.Pet.PetPreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumi - Pet Preferences"
        Height="600"
        Width="440"
        MinWidth="400"
        MinHeight="500"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        Background="#171220"
        Foreground="#FFF0FC"
        WindowStartupLocation="CenterOwner"
        Topmost="True">
        <Grid Margin="12">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="PET PREFERENCES"
                           Foreground="#f4e8fa"
                           FontWeight="Bold"
                           FontSize="12"
                           Margin="0,0,0,12"/>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Character renderer"
                                                   Foreground="#c5b5d1"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"/>
                                        <ComboBox x:Name="DisplayModeCombo"
                                                  SelectedValuePath="Tag"
                                                  Padding="6"
                                                  Background="#211A2C"
                                                  BorderBrush="#493958"
                                                  Foreground="#FFF0FC">
                                                <ComboBoxItem Tag="png"
                                                              Content="PNG sprite"/>
                                                <ComboBoxItem Tag="2d"
                                                              Content="Live2D 2D"/>
                                                <ComboBoxItem Tag="3d"
                                                              Content="3D VRM"/>
                                        </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Character scale"
                                                   Foreground="#c5b5d1"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"/>
                                        <Slider x:Name="CharacterScaleSlider"
                                                Minimum="0.5"
                                                Maximum="1.35"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="CharacterScaleSlider_ValueChanged"/>
                                        <TextBlock x:Name="CharacterScaleValue"
                                                   Foreground="#aa9bb8"
                                                   FontSize="10"
                                                   Margin="4,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Character position X"
                                                   Foreground="#c5b5d1"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"/>
                                        <Slider x:Name="CharacterXSlider"
                                                Minimum="-1"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="CharacterXSlider_ValueChanged"/>
                                        <TextBlock x:Name="CharacterXValue"
                                                   Foreground="#aa9bb8"
                                                   FontSize="10"
                                                   Margin="4,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Character position Y"
                                                   Foreground="#c5b5d1"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"/>
                                        <Slider x:Name="CharacterYSlider"
                                                Minimum="-1"
                                                Maximum="1"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="CharacterYSlider_ValueChanged"/>
                                        <TextBlock x:Name="CharacterYValue"
                                                   Foreground="#aa9bb8"
                                                   FontSize="10"
                                                   Margin="4,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Roaming walking speed"
                                                   Foreground="#c5b5d1"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"/>
                                        <Slider x:Name="WalkingSpeedSlider"
                                                Minimum="0.05"
                                                Maximum="0.5"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="WalkingSpeedSlider_ValueChanged"/>
                                        <TextBlock x:Name="WalkingSpeedValue"
                                                   Foreground="#aa9bb8"
                                                   FontSize="10"
                                                   Margin="4,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Behavior"
                                                   Foreground="#c5b5d1"
                                                   FontSize="11"
                                                   Margin="0,0,0,8"/>
                                        <CheckBox x:Name="RoamingCheck"
                                                  Content="Roaming (pet wanders across the desktop)"
                                                  Foreground="#c5b5d1"
                                                  Margin="0,0,0,6"/>
                                        <CheckBox x:Name="AlwaysOnTopCheck"
                                                  Content="Always on top"
                                                  Foreground="#c5b5d1"
                                                  Margin="0,0,0,6"/>
                                        <CheckBox x:Name="EdgeHideCheck"
                                                  Content="Hide at screen edges"
                                                  Foreground="#c5b5d1"
                                                  Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ClickThroughCheck"
                                                  Content="Click-through overlay (Ctrl + Alt + I toggles)"
                                                  Foreground="#c5b5d1"
                                                  Margin="0,0,0,6"/>
                                        <CheckBox x:Name="MouseAvoidanceCheck"
                                                  Content="Hide when mouse hovers over Lumi"
                                                  Foreground="#c5b5d1"/>
                                        <TextBlock Text="Note: click-through disables clicks on Lumi while active. Mouse avoidance uses the pet window bounds."
                                                   TextWrapping="Wrap"
                                                   Foreground="#8f819e"
                                                   FontSize="10"
                                                   Margin="0,8,0,0"/>
                                </StackPanel>
                        </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2"
                        Background="#171220"
                        Padding="0,10,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Click="Cancel_Click"
                                        Padding="12,6"
                                        Margin="0,0,10,0"/>
                                <Button Content="Save"
                                        Click="Save_Click"
                                        Padding="14,6"
                                        Background="#6F4A8C"
                                        BorderBrush="#A681C5"
                                        Foreground="White"/>
                        </StackPanel>
                </Border>
        </Grid>
</Window>
