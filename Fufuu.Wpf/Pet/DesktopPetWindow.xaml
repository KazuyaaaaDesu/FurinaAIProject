<Window x:Class="Fufuu.Wpf.Pet.DesktopPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Fufuu Desktop Pet"
        Width="360"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">
        <Grid Background="Transparent">
                <wv2:WebView2 x:Name="PetWebView"
                              DefaultBackgroundColor="Transparent"/>

                <!-- Control Bar Panel -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0"
                        Background="#EE171220"
                        CornerRadius="10"
                        Padding="6"
                        SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                                <Button Content="2D"
                                        Click="Mode2D_Click"
                                        Padding="8,3"
                                        Margin="1"
                                        ToolTip="Use Live2D"/>
                                <Button Content="3D"
                                        Click="Mode3D_Click"
                                        Padding="8,3"
                                        Margin="1"
                                        ToolTip="Use VRM"/>
                                <Button Content="⇄"
                                        Click="Roam_Click"
                                        Padding="8,3"
                                        Margin="1"
                                        ToolTip="Toggle roaming"/>
                                <Button Content="✕"
                                        Click="Close_Click"
                                        Padding="8,3"
                                        Margin="1"
                                        Foreground="#FFFF5555"
                                        ToolTip="Close desktop pet (Esc)"/>
                        </StackPanel>
                </Border>
        </Grid>
</Window>