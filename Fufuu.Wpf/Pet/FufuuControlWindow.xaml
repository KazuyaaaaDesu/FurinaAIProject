<Window x:Class="Fufuu.Wpf.Pet.FufuuControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMI CONTROL"
        Height="320"
        Width="260"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#171220"
        Topmost="True">
        <Grid Margin="12">
                <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="LUMI CONTROL"
                                   Foreground="#f4e8fa"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>
                        <Button Content="Cycle Character Renderer (PNG / Live2D / 3D)"
                                Margin="0,4"
                                Padding="8"
                                Click="OnSwitchModeClicked"/>
                        <Button Content="Open Chat"
                                Margin="0,4"
                                Padding="8"
                                Click="OnOpenChatClicked"/>
                        <Button Content="Pet Preferences"
                                Margin="0,4"
                                Padding="8"
                                Click="OnPreferencesClicked"/>
                        <Button Content="Quit Pet"
                                Margin="0,4"
                                Padding="8"
                                Click="OnQuitClicked"
                                Foreground="#ff6b6b"/>
                </StackPanel>
        </Grid>
</Window>