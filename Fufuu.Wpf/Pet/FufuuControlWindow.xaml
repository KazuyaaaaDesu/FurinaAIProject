<Window x:Class="Fufuu.Wpf.Pet.FufuuControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumi Control Center"
        Height="480"
        Width="340"
        MinHeight="480"
        MinWidth="340"
        MaxHeight="480"
        MaxWidth="340"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#111019"
        Foreground="#F1EFF8"
        FontFamily="Segoe UI"
        Topmost="True">

        <Window.Resources>
                <SolidColorBrush x:Key="MutedBrush"
                                 Color="#9693A8"/>

                <Style x:Key="ActionButton"
                       TargetType="{x:Type Button}">
                        <Setter Property="Background"
                                Value="#191823"/>
                        <Setter Property="Foreground"
                                Value="#F1EFF8"/>
                        <Setter Property="BorderBrush"
                                Value="#302D40"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Padding"
                                Value="12"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="9"
                                                        SnapsToDevicePixels="True">
                                                        <ContentPresenter
                                                                Margin="{TemplateBinding Padding}"
                                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                RecognizesAccessKey="True"/>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#252235"/>
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="BorderBrush"
                                                                        Value="#66578C"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Background"
                                                                        Value="#302843"/>
                                                        </Trigger>

                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="Opacity"
                                                                        Value="0.45"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </Window.Resources>

        <Grid Margin="18">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                CornerRadius="11"
                                Background="#29223B"
                                BorderBrush="#51416F"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                                <TextBlock Text="L"
                                           Foreground="#D7C8FF"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="11,0,0,0">
                                <TextBlock Text="LUMI"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#F5F1FF"/>

                                <TextBlock Text="CONTROL CENTER"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="1,2,0,0"/>
                        </StackPanel>
                </Grid>

                <!-- Intro -->
                <StackPanel Grid.Row="2">
                        <TextBlock Text="COMPANION"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"/>

                        <TextBlock Text="What would you like to do?"
                                   FontSize="13"
                                   Foreground="#D5D1E1"
                                   Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Character renderer -->
                <Button Grid.Row="4"
                        Style="{StaticResource ActionButton}"
                        Click="OnSwitchModeClicked"
                        AutomationProperties.Name="Cycle character renderer">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#302743"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="◇"
                                                   FontSize="21"
                                                   Foreground="#D0BCFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="10,0,4,0">
                                        <TextBlock Text="Character display"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="PNG · Live2D · 3D"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,3,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="23"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                        </Grid>
                </Button>

                <!-- Chat -->
                <Button Grid.Row="6"
                        Style="{StaticResource ActionButton}"
                        Click="OnOpenChatClicked"
                        AutomationProperties.Name="Open chat">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#23332F"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="✉"
                                                   FontSize="16"
                                                   Foreground="#A7E3CD"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="10,0,4,0">
                                        <TextBlock Text="Talk to Lumi"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Open your conversation"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,3,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="23"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                        </Grid>
                </Button>

                <!-- Preferences -->
                <Button Grid.Row="8"
                        Style="{StaticResource ActionButton}"
                        Click="OnPreferencesClicked"
                        AutomationProperties.Name="Open pet preferences">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#303044"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="⚙"
                                                   FontSize="17"
                                                   Foreground="#C8C5FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="10,0,4,0">
                                        <TextBlock Text="Preferences"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Behavior and appearance"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,3,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="›"
                                           FontSize="23"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                        </Grid>
                </Button>

                <!-- Quit -->
                <Button Grid.Row="10"
                        Style="{StaticResource ActionButton}"
                        Background="#21171F"
                        BorderBrush="#4A2938"
                        Click="OnQuitClicked"
                        AutomationProperties.Name="Quit Lumi">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="#3A202D"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="×"
                                                   FontSize="23"
                                                   Foreground="#FF9BAE"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                        <TextBlock Text="Quit Lumi"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFB4C1"/>
                                        <TextBlock Text="Close the desktop companion"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,3,0,0"/>
                                </StackPanel>
                        </Grid>
                </Button>
        </Grid>
</Window>
