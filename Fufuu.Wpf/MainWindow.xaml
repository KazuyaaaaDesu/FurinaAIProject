<Window x:Class="Fufuu.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumi"
        Width="1040"
        Height="820"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <Border CornerRadius="20"
            Background="#100D18"
            BorderBrush="#493958"
            BorderThickness="1"
            Padding="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Custom title bar -->
            <Border Grid.Row="0"
                    Background="#171220"
                    CornerRadius="19,19,0,0"
                    Padding="20,15"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="43"
                                Height="43"
                                CornerRadius="14"
                                Background="#34253F"
                                BorderBrush="#72537F"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <TextBlock Text="🌸"
                                       FontSize="23"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lumi"
                                       Foreground="#FFF0FC"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4,0,0">
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="#83D9A4"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0"/>
                                <TextBlock x:Name="ConnectionStatus"
                                           Text="Local companion · checking Ollama…"
                                           Foreground="#B8A6BF"
                                           FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Background="#14271D"
                                BorderBrush="#355A42"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="9,5"
                                Margin="0,0,10,0">
                            <TextBlock Text="LOCAL AI"
                                       Foreground="#9CE8B6"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </Border>
                        <Button Style="{StaticResource PillButton}"
                                Content="—"
                                Width="34"
                                Padding="0"
                                Click="MinimizeButton_Click"
                                Margin="0,0,6,0"/>
                        <Button Style="{StaticResource PillButton}"
                                Content="♡   Desktop Pet"
                                Click="DesktopPetButton_Click"
                                Margin="0,0,6,7"/>
                        <Button Style="{StaticResource PillButton}"
                                Content="✦   Memories"
                                HorizontalContentAlignment="Left"
                                Click="MemoriesButton_Click"
                                Margin="0,0,0,7"/>
                        <Button Style="{StaticResource PillButton}"
                                Content="×"
                                Width="34"
                                Padding="0"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="20,18,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="#15111F"
                        BorderBrush="#30263D"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="14">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="YOUR COMPANION"
                                       Foreground="#AA9BB8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="2,2,0,12"/>
                            <Border Background="#241B30"
                                    BorderBrush="#594268"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Border Width="55"
                                                Height="55"
                                                CornerRadius="18"
                                                Background="#49304F"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="✦"
                                                       Foreground="#F5D6F1"
                                                       FontSize="30"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center"
                                                    Margin="67,0,0,0">
                                            <TextBlock Text="Lumi"
                                                       Foreground="#FFF0FC"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Always nearby ♡"
                                                       Foreground="#B8A6BF"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Your local AI companion"
                                               Foreground="#C5B5D1"
                                               FontSize="11"
                                               Margin="0,12,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="QUICK ACTIONS"
                                       Foreground="#AA9BB8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="2,0,0,9"/>
                            <Button Style="{StaticResource PillButton}"
                                    Content="＋   New chat"
                                    HorizontalContentAlignment="Left"
                                    Click="NewChatButton_Click"
                                    Margin="0,0,0,7"/>
                            <Button x:Name="VoiceButton"
                                    Style="{StaticResource PillButton}"
                                    Content="◉   Voice: OFF"
                                    HorizontalContentAlignment="Left"
                                    Click="VoiceButton_Click"
                                    Margin="0,0,0,7"/>
                            <Button Style="{StaticResource PillButton}"
                                    Content="◈   Ambient mode · next phase"
                                    HorizontalContentAlignment="Left"
                                    IsEnabled="False"
                                    Margin="0,0,0,7"/>
                            <Button x:Name="CaptureScreenButton"
                                    Style="{StaticResource PillButton}"
                                    Content="▧   Capture screen"
                                    HorizontalContentAlignment="Left"
                                    Click="CaptureScreenButton_Click"
                                    Margin="0,0,0,7"/>

                            <Button x:Name="VisionModeButton"
                                    Style="{StaticResource PillButton}"
                                    Content="◈   Vision Mode: OFF"
                                    HorizontalContentAlignment="Left"
                                    Click="VisionModeButton_Click"
                                    Margin="0,0,0,7"/>

                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Margin="0,14,0,0">
                            <Border Height="1"
                                    Background="#30263D"
                                    Margin="0,0,0,12"/>
                            <TextBlock Text="PRIVACY FIRST"
                                       Foreground="#D9C4EE"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Chat requests go to Ollama on this computer. This starter does not write to your existing conversation or memory files."
                                       Foreground="#9C8DA9"
                                       FontSize="10"
                                       LineHeight="15"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                            <TextBlock Text="WPF migration · Phase 1"
                                       Foreground="#766783"
                                       FontSize="10"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Conversation -->
                <Border Grid.Column="2"
                        Background="#171220"
                        BorderBrush="#30263D"
                        BorderThickness="1"
                        CornerRadius="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="#30263D"
                                BorderThickness="0,0,0,1"
                                Padding="18,15">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Chat with Lumi"
                                               Foreground="#FFF0FC"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="A little corner of Fontaine, running locally."
                                               Foreground="#AA9BB8"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource PillButton}"
                                        Content="Clear view"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="NewChatButton_Click"/>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="MessagesScroll"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="18,16">
                            <StackPanel x:Name="MessagesPanel">
                                <Border Background="#211A2C"
                                        BorderBrush="#493958"
                                        BorderThickness="1"
                                        CornerRadius="13,13,13,3"
                                        Padding="14"
                                        HorizontalAlignment="Left"
                                        MaxWidth="570"
                                        Margin="0,0,25,14">
                                    <StackPanel>
                                        <TextBlock Text="Lumi  ·  just now"
                                                   Foreground="#D7B9F0"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,7"/>
                                        <TextBlock Text="Oh? You're here. What is it? ♡"
                                                   Foreground="#EEE6F5"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2"
                                Background="#15111F"
                                BorderBrush="#30263D"
                                BorderThickness="0,1,0,0"
                                Padding="14">
                            <StackPanel>
                                <TextBox x:Name="MessageInput"
                                         Style="{StaticResource RoundInput}"
                                         MinHeight="52"
                                         MaxHeight="130"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         KeyDown="MessageInput_KeyDown"
                                         ToolTip="Message Lumi… (Enter to send, Shift+Enter for a new line)"/>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock x:Name="FooterStatus"
                                               Text="Your messages stay on this computer unless the local model service says otherwise."
                                               Foreground="#82728F"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="SendButton"
                                            Grid.Column="1"
                                            Style="{StaticResource PillButton}"
                                            Content="Send  ➤"
                                            Background="#6F4A8C"
                                            BorderBrush="#A681C5"
                                            Padding="18,9"
                                            HorizontalAlignment="Right"
                                            Click="SendButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2"
                    Background="#120F1A"
                    CornerRadius="0,0,19,19"
                    Padding="18,8">
                <DockPanel>
                    <TextBlock Text="Lumi · native WPF preview"
                               Foreground="#786A86"
                               FontSize="10"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="Ollama  •  localhost:11434"
                               Foreground="#786A86"
                               FontSize="10"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
