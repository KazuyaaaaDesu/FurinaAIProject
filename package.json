{
  "name": "localcompanion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/discord-bot",
    "services/agent-api",
    "services/storage"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @lumi/web",
    "build": "npm run build --workspace @lumi/web",
    "lint": "eslint .",
    "preview": "npm run preview --workspace @lumi/web",
    "desktop": "dotnet run --project apps/desktop-wpf/Fufuu.Wpf.csproj",
    "discord": "node apps/discord-bot/src/bot.js",
    "storage": "node services/storage/server.js",
    "agent-api": "node services/agent-api/server.js",
    "omnivoice": ".\\omnivoice\\.venv\\Scripts\\python.exe services/speech/omnivoice/omnivoice_server.py",
    "test": "node --test",
    "test:agent": "node --test tests/agent/*.test.js",
    "test:storage": "node --test tests/integration/storage.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.69.0"
  }
}
