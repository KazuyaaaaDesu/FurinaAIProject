body.avatar-mode {
  margin: 0 !important;
  overflow: hidden !important;
  background: transparent !important;
}

body.avatar-mode #root {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: transparent !important;
}

.sakura-stage {
  --pink-light: #ffd5ef;
  --pink: #f48bc9;
  --pink-dark: #c75b9f;
  --mood-glow: #f4a4df;

  position: relative;
  isolation: isolate;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 6px;
  overflow: hidden;
  color: #fff4fb;
  font-family: "Segoe UI", sans-serif;
  user-select: none;
  -webkit-app-region: drag;
}

.sakura-aura {
  position: absolute;
  z-index: -1;
  top: 22px;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: var(--mood-glow);
  opacity: 0.2;
  filter: blur(27px);
  animation: aura-breathe 4s ease-in-out infinite;
  transition: background 700ms ease;
}

.sakura-orb-button {
  position: relative;
  display: grid;
  place-items: center;
  width: 144px;
  height: 130px;
  flex-shrink: 0;
  padding: 0;
  border: 0;
  outline: none;
  background: transparent;
  cursor: pointer;
  -webkit-app-region: no-drag;
}

.sakura-orb-button:focus-visible {
  border-radius: 50%;
  outline: 2px solid #fff0fb;
  outline-offset: -2px;
}

.sakura-orb {
  position: relative;
  width: 108px;
  height: 108px;
  border: 1px solid #fff5ff9c;
  border-radius: 43% 57% 51% 49% / 48% 42% 58% 52%;
  background:
    radial-gradient(circle at 29% 23%, #fff 0 3%, transparent 4%),
    radial-gradient(ellipse at 34% 28%, #ffe6f7 0%, #ffc7e8 25%, transparent 51%),
    linear-gradient(145deg, var(--pink-light) 2%, var(--pink) 54%, var(--pink-dark) 100%);
  box-shadow:
    0 8px 22px #a84d9450,
    inset -8px -10px 16px #a8409850,
    inset 5px 5px 14px #fff4ffb0;
  animation: sakura-float 3.4s ease-in-out infinite;
  transition: background 600ms ease, box-shadow 600ms ease;
}

.sakura-orb-button:hover .sakura-orb {
  box-shadow:
    0 8px 28px #d95ebc70,
    inset -8px -10px 16px #a8409840,
    inset 5px 5px 14px #fff4ffb0;
}

.sakura-ear {
  position: absolute;
  top: 7px;
  width: 24px;
  height: 19px;
  border-radius: 50%;
  background: #ffd6ef;
  opacity: 0.9;
}

.sakura-ear.left {
  left: 14px;
  transform: rotate(-30deg);
}

.sakura-ear.right {
  right: 13px;
  transform: rotate(30deg);
}

.sakura-flower {
  position: absolute;
  z-index: 3;
  top: 6px;
  right: 12px;
  width: 27px;
  height: 27px;
  display: grid;
  place-items: center;
  border: 1px solid #fff8ff;
  border-radius: 50%;
  background: #fff0fa;
  color: #dc65ad;
  box-shadow: 0 2px 7px #9e438755;
  transform: rotate(15deg);
}

.sakura-flower span {
  font-size: 25px;
  line-height: 1;
}

.sakura-flower i {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #ffd26e;
}

.sakura-face {
  position: absolute;
  top: 42px;
  left: 0;
  width: 100%;
  height: 46px;
}

.sakura-eyes {
  display: flex;
  justify-content: center;
  gap: 26px;
}

.eye {
  position: relative;
  display: block;
  width: 10px;
  height: 14px;
  border-radius: 48% 48% 50% 50%;
  background: #66344f;
  box-shadow: inset 1px 1px 1px #ffffff80;
  transform-origin: center;
  animation: sakura-blink 5.5s infinite;
}

.eye i {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 3px;
  height: 4px;
  border-radius: 50%;
  background: white;
}

.sakura-blush {
  position: absolute;
  top: 18px;
  width: 16px;
  height: 8px;
  border-radius: 50%;
  background: #f66eaf;
  opacity: 0.72;
  filter: blur(0.4px);
  transition: opacity 300ms ease, transform 300ms ease;
}

.sakura-blush.left {
  left: 18px;
}

.sakura-blush.right {
  right: 18px;
}

.sakura-mouth {
  position: absolute;
  top: 22px;
  left: 50%;
  width: 14px;
  height: 8px;
  transform: translateX(-50%);
}

.mouth-smile {
  position: absolute;
  top: 0;
  left: 2px;
  width: 10px;
  height: 6px;
  border-bottom: 2px solid #91466f;
  border-radius: 0 0 50% 50%;
  transition: opacity 150ms ease;
}

.mouth-open {
  position: absolute;
  top: 0;
  left: 4px;
  width: 7px;
  height: 8px;
  border-radius: 50%;
  background: #91466f;
  opacity: 0;
  transform: scale(0.4);
  transition: opacity 150ms ease, transform 150ms ease;
}

.sakura-shine {
  position: absolute;
  border-radius: 50%;
  background: #ffffff80;
  filter: blur(1.5px);
  pointer-events: none;
}

.sakura-shine.one {
  top: 26px;
  left: 13px;
  width: 11px;
  height: 23px;
  transform: rotate(30deg);
}

.sakura-shine.two {
  top: 43px;
  left: 9px;
  width: 5px;
  height: 9px;
  opacity: 0.7;
}

.sakura-sparkle {
  position: absolute;
  color: #fff5ff;
  opacity: 0;
  pointer-events: none;
}

.sparkle-one {
  top: 14px;
  left: -8px;
  font-size: 18px;
}

.sparkle-two {
  right: -9px;
  bottom: 17px;
  font-size: 23px;
}

/* Calm: gentle floating */

.mood-calm .sakura-orb {
  animation: sakura-float 3.4s ease-in-out infinite;
}

/* Happy: cheerful bounce and smile */

.mood-happy .sakura-orb {
  animation: sakura-happy 1.3s ease-in-out infinite;
}

.mood-happy .sakura-eyes {
  transform: translateY(1px);
}

.mood-happy .eye {
  height: 7px;
  margin-top: 5px;
  border-radius: 50%;
  border-bottom: 2px solid #66344f;
  background: transparent;
  box-shadow: none;
  animation: none;
}

.mood-happy .eye i {
  display: none;
}

.mood-happy .mouth-smile {
  width: 13px;
  height: 8px;
  border-bottom-width: 3px;
}

.mood-happy .sakura-blush {
  opacity: 1;
  transform: scale(1.2);
}

/* Curious: tilt, wide eyes, and an open mouth */

.mood-curious .sakura-orb {
  animation: sakura-curious 2.4s ease-in-out infinite;
}

.mood-curious .eye {
  width: 11px;
  height: 16px;
  animation: none;
}

.mood-curious .mouth-open {
  opacity: 1;
  transform: scale(1);
}

.mood-curious .mouth-smile {
  opacity: 0;
}

.mood-curious .sakura-flower {
  animation: flower-wiggle 2s ease-in-out infinite;
}

/* Sleepy: droopy eyes and slower movement */

.mood-sleepy .sakura-orb {
  animation: sakura-sleepy 5s ease-in-out infinite;
}

.mood-sleepy .eye {
  height: 6px;
  margin-top: 6px;
  border-radius: 50%;
  border-bottom: 2px solid #66344f;
  background: transparent;
  box-shadow: none;
  animation: none;
}

.mood-sleepy .eye i {
  display: none;
}

.mood-sleepy .sakura-blush {
  opacity: 0.45;
}

.mood-sleepy .sakura-aura {
  opacity: 0.12;
}

/* Excited: energetic bounce and twinkling stars */

.mood-excited .sakura-orb {
  animation: sakura-excited 0.75s ease-in-out infinite;
}

.mood-excited .mouth-open {
  opacity: 1;
  transform: scale(1.15);
}

.mood-excited .mouth-smile {
  opacity: 0;
}

.mood-excited .sparkle-one {
  animation: sparkle 1.2s ease-in-out infinite;
}

.mood-excited .sparkle-two {
  animation: sparkle 1.2s ease-in-out 0.4s infinite;
}

.mood-excited .sakura-aura {
  opacity: 0.35;
}

.sakura-name {
  font-size: 13px;
  font-weight: 750;
  color: #fff2fc;
  text-shadow: 0 1px 5px #8e347e;
  letter-spacing: 0.4px;
  -webkit-app-region: drag;
}

.sakura-name span {
  display: inline-block;
  animation: flower-wiggle 3s ease-in-out infinite;
}

.sakura-mood-label {
  max-width: 170px;
  min-height: 15px;
  overflow: hidden;
  color: #fff5fd;
  font-size: 10px;
  font-weight: 500;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 1px 5px #753064;
  -webkit-app-region: drag;
}

.sakura-chat-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 3px;
  padding: 7px 13px;
  border: 1px solid #ffffffb0;
  border-radius: 999px;
  background: #fff2faee;
  color: #9b3c80;
  font: 650 11px "Segoe UI", sans-serif;
  cursor: pointer;
  box-shadow: 0 3px 12px #8b3a8050;
  transition: transform 160ms ease, background 160ms ease;
  -webkit-app-region: no-drag;
}

.sakura-chat-button:hover {
  background: #fff;
  transform: translateY(-2px);
}

.sakura-chat-button:active {
  transform: scale(0.96);
}

.sakura-chat-button .chat-sparkle {
  font-size: 14px;
}

.sakura-chat-button.chat-opened {
  background: #ffe0f3;
}

/* Animations */

@keyframes sakura-float {
  0%, 100% {
    transform: translateY(0) rotate(-2deg);
  }

  50% {
    transform: translateY(-6px) rotate(2deg);
  }
}

@keyframes sakura-happy {
  0%, 100% {
    transform: translateY(0) rotate(-3deg) scale(1);
  }

  50% {
    transform: translateY(-8px) rotate(3deg) scale(1.025);
  }
}

@keyframes sakura-curious {
  0%, 100% {
    transform: translateY(0) rotate(-5deg);
  }

  50% {
    transform: translateY(-3px) rotate(5deg);
  }
}

@keyframes sakura-sleepy {
  0%, 100% {
    transform: translateY(2px) rotate(-1deg) scale(0.99);
  }

  50% {
    transform: translateY(5px) rotate(1deg) scale(0.97);
  }
}

@keyframes sakura-excited {
  0%, 100% {
    transform: translateY(0) rotate(-4deg) scale(1);
  }

  25% {
    transform: translateY(-6px) rotate(3deg) scale(1.04);
  }

  50% {
    transform: translateY(-2px) rotate(-2deg) scale(1.01);
  }

  75% {
    transform: translateY(-8px) rotate(4deg) scale(1.04);
  }
}

@keyframes sakura-blink {
  0%, 43%, 47%, 100% {
    transform: scaleY(1);
  }

  45% {
    transform: scaleY(0.1);
  }
}

@keyframes flower-wiggle {
  0%, 100% {
    transform: rotate(-8deg);
  }

  50% {
    transform: rotate(12deg);
  }
}

@keyframes sparkle {
  0%, 100% {
    opacity: 0;
    transform: scale(0.5) rotate(0deg);
  }

  50% {
    opacity: 1;
    transform: scale(1.2) rotate(25deg);
  }
}

@keyframes aura-breathe {
  0%, 100% {
    transform: scale(0.85);
  }

  50% {
    transform: scale(1.15);
  }
}

@media (prefers-reduced-motion: reduce) {
  .sakura-orb,
  .sakura-eyes span,
  .sakura-name span,
  .sakura-flower,
  .sakura-sparkle,
  .sakura-aura {
    animation: none !important;
  }
}

/* Fufuu 3D mode placeholder; replaced by the VRM renderer later */
.fufuu-3d-placeholder {
  display: none;
  width: 100%;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 20px 12px 12px;
  color: #f4edff;
  text-align: center;
  font-family: inherit;
}

.fufuu-3d-icon {
  display: grid;
  place-items: center;
  width: 86px;
  height: 86px;
  margin-bottom: 2px;
  border: 1px solid rgba(209, 177, 255, 0.65);
  border-radius: 25px;
  background: radial-gradient(circle at 35% 25%, #8e79c7, #29233f 72%);
  box-shadow: 0 0 30px rgba(168, 124, 255, 0.25);
  color: #fff;
  font-size: 60px;
  line-height: 1;
}

.fufuu-3d-placeholder strong {
  font-size: 14px;
}

.fufuu-3d-placeholder span {
  max-width: 180px;
  color: rgba(244, 237, 255, 0.72);
  font-size: 11px;
  line-height: 1.5;
}

.sakura-stage.mode-3d .fufuu-3d-placeholder {
  display: flex;
}

.sakura-stage.mode-3d .sakura-orb-button,
.sakura-stage.mode-3d .sakura-aura,
.sakura-stage.mode-3d .sakura-name,
.sakura-stage.mode-3d .sakura-mood-label {
  display: none;
}

/* Fufuu VRM viewer */
.fufuu-vrm-viewer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 5;
  overflow: hidden;
}

.fufuu-vrm-status {
  position: absolute;
  top: 6px;
  left: 6px;
  right: 6px;
  z-index: 6;
  padding: 5px 8px;
  border-radius: 8px;
  background: rgba(20, 20, 30, 0.72);
  color: #fff;
  font: 11px/1.4 system-ui, sans-serif;
  text-align: center;
  pointer-events: none;
}

.fufuu-vrm-status.is-error {
  color: #ffb4b4;
}

/* Final 3D mode layering */
.sakura-stage.mode-3d .fufuu-3d-placeholder {
  display: none !important;
}

.sakura-stage.mode-3d .fufuu-vrm-viewer {
  display: block;
  z-index: 5;
}

.sakura-stage.mode-3d .sakura-chat-button {
  position: absolute;
  z-index: 10;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}

.sakura-stage.mode-3d .sakura-chat-button:hover {
  transform: translateX(-50%) translateY(-2px);
}

.sakura-stage.mode-3d .sakura-chat-button:active {
  transform: translateX(-50%) scale(0.96);
}

.sakura-stage.mode-3d .fufuu-vrm-status:not(.is-error) {
  display: none;
}
