import { useEffect, useState } from "react";
import "./Avatar.css";

type DisplayMode = "2d" | "3d";
type Mood = "happy" | "curious" | "sleepy" | "excited" | "calm";

const MOODS: Mood[] = ["calm", "happy", "curious", "sleepy", "excited"];

const MOOD_LABELS: Record<Mood, string> = {
  calm: "Just hanging out",
  happy: "Happy to see you!",
  curious: "What's that?",
  sleepy: "A little sleepy...",
  excited: "Let's do something!",
};

export default function Avatar() {
  const [mood, setMood] = useState<Mood>("calm");
  const [displayMode, setDisplayMode] = useState<DisplayMode>(() =>
    window.localStorage.getItem("fufuu-display-mode") === "3d" ? "3d" : "2d"
  );
  const [hovering, setHovering] = useState(false);
  const [chatOpened, setChatOpened] = useState(false);

  useEffect(() => {
    document.body.classList.add("avatar-mode");

    let index = 0;
    const interval = window.setInterval(() => {
      index = (index + 1) % MOODS.length;
      setMood(MOODS[index]);
    }, 12000);

    return () => {
      window.clearInterval(interval);
      document.body.classList.remove("avatar-mode");
    };
  }, []);

  useEffect(() => {
    function syncDisplayMode(event: StorageEvent) {
      if (event.key === "fufuu-display-mode") {
        setDisplayMode(event.newValue === "3d" ? "3d" : "2d");
      }
    }

    window.addEventListener("storage", syncDisplayMode);
    return () => window.removeEventListener("storage", syncDisplayMode);
  }, []);

  function cycleMood() {
    setMood((current) => {
      const index = MOODS.indexOf(current);
      return MOODS[(index + 1) % MOODS.length];
    });
  }

  function openChat() {
    setMood("excited");
    setChatOpened(true);
    window.sakuraDesktop?.openChat();
    window.setTimeout(() => setChatOpened(false), 1800);
  }

  const expression = hovering ? "curious" : mood;

  return (
    <main className={`sakura-stage mood-${expression} mode-${displayMode}`}>
      <div className="fufuu-3d-placeholder" role="status">
        <div className="fufuu-3d-icon" aria-hidden="true">◇</div>
        <strong>Fufuu · 3D Mode</strong>
        <span>VRM character renderer not installed yet.</span>
      </div>
      <div className="sakura-aura" />

      <button
        className="sakura-orb-button"
        type="button"
        aria-label={`Fufuu is ${expression}. Click to change her mood.`}
        title="Click me to change my expression!"
        onClick={cycleMood}
        onMouseEnter={() => setHovering(true)}
        onMouseLeave={() => setHovering(false)}
      >
        <div className="sakura-orb">
          <div className="sakura-ear left" />
          <div className="sakura-ear right" />

          <div className="sakura-flower">
            <span>✿</span>
            <i />
          </div>

          <div className="sakura-face">
            <div className="sakura-eyes">
              <span className="eye left-eye">
                <i />
              </span>
              <span className="eye right-eye">
                <i />
              </span>
            </div>

            <div className="sakura-blush left" />
            <div className="sakura-blush right" />

            <div className="sakura-mouth">
              <span className="mouth-smile" />
              <span className="mouth-open" />
            </div>
          </div>

          <div className="sakura-shine one" />
          <div className="sakura-shine two" />

          <span className="sakura-sparkle sparkle-one">✦</span>
          <span className="sakura-sparkle sparkle-two">✧</span>
        </div>
      </button>

      <div className="sakura-name">Fufuu <span>🌸</span></div>

      <div className="sakura-mood-label" aria-live="polite">
        {hovering ? "Hehe, you found me!" : MOOD_LABELS[mood]}
      </div>

      <button
        className={`sakura-chat-button ${chatOpened ? "chat-opened" : ""}`}
        onClick={openChat}
        type="button"
      >
        <span className="chat-sparkle">✧</span>
        {chatOpened ? "Coming right up!" : "Chat with me"}
      </button>
    </main>
  );
}
